# 第二屏直播推流配置（desktop-live-push）
#
# 二选一：
#   1) 直接填完整 RTMP URL（包含 YouTube 直播密钥）
#   2) 只填 YOUTUBE_STREAM_KEY，由脚本拼成 rtmp://a.rtmp.youtube.com/live2/<key>
#
# 不要把真实密钥提交到代码仓库；建议：
#   install -m 0640 -o root -g vncuser1 desktop-live.env.example /etc/default/desktop-live

RTMP_URL=
YOUTUBE_STREAM_KEY=

# 可选：出站 1935 被阻断时走 RTMPS 443。
# 注意 RTMPS 主机是 rtmps.youtube.com，不是 a.rtmp.youtube.com。
# YOUTUBE_RTMP_BASE=rtmps://rtmps.youtube.com:443/live2

# 复用 MediaMTX 的 desktop_av（H.264 + Opus），不重新编码视频
LIVE_RTSP_URL=rtsp://127.0.0.1:8554/desktop_av

# YouTube 音频用 AAC；192k 与桌面音频源一致
LIVE_AUDIO_BITRATE=192k
